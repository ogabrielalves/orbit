{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBIT",
  "version": "0.1.0",
  "identifier": "dev.orbit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ORBIT",
        "width": 1280,
        "height": 800,
        "minWidth": 834,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first desktop app for projects, Kanban boards, notes and a knowledge graph",
    "longDescription": "ORBIT keeps your projects, Kanban boards, Markdown notes and knowledge graph in one local-first desktop app. Your data stays on your computer, with no account and no cloud.",
    "publisher": "Gabriel Alves",
    "copyright": "Copyright (c) 2026 Gabriel Alves",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
